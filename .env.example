# ==============================================================================
# AI Personal Finance Coach — Environment Configuration Template
# Copy this file to .env and populate the required API credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Anthropic Claude API Key (Required for Plan Generation & HHH Evaluation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Supabase Persistence & Auth (Required for Supabase DB integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Trello Board Integration (Optional for local script sync)
TRELLO_BOARD_ID=6ac3cb6487ae8c9113244394
TRELLO_BOARD_URL=https://trello.com/b/luRtFTDN/ai-personal-finance-coach
